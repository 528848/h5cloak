APP_NAME="Cloak"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.cloak.example.com
MERCHANT_PORTAL_URL=https://merchant.cloak.example.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloak
DB_USERNAME=cloak
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 斗篷流量入口（商户域名 CNAME 解析目标）
CLOAK_ENTRY_HOST=entry.cloak.example.com
# 可选：A 记录 IP，多个用英文逗号分隔
CLOAK_ENTRY_IPS=
# 可选：整域托管 Nameservers，多个用英文逗号分隔
CLOAK_ENTRY_NAMESERVERS=

SANCTUM_STATEFUL_DOMAINS=cloak.example.com,merchant.cloak.example.com,api.cloak.example.com
