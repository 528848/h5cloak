{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "baseUrl": "./",
    "lib": ["esnext", "dom"],
    "paths": {
      "@/*": ["src/*"],
      "@portal": ["src/portals/admin.js"],
      "ele-admin-plus/es/*": ["components/*"],
      "ele-admin-plus/es": ["components/index"],
      "ele-admin-plus": ["components/index"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
